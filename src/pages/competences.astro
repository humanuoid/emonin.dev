---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import SiteHeader from '../components/site-header.astro';
import PageHeader from '../components/page-header.astro';
import SkillsSection from '../components/skills-section.astro';
import ProjectCard from '../components/project-card.astro';
import SiteFooter from '../components/site-footer.astro';

// Skills groups; real content comes from Emmanuel's CV and LinkedIn profile
const skillGroups = [
  { title: 'Langages', items: ['TypeScript', 'Python', 'SQL', 'HTML / CSS'] },
  { title: 'Data & IA', items: ['Pipelines de données', 'LLM & RAG', 'MLOps'] },
  { title: 'Produit', items: ['Conception produit', 'UX', 'Méthodes agiles'] },
];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Compétences — Emmanuel Monin"
  description="Compétences et projets d'Emmanuel Monin, développeur web."
>
  <SiteHeader />
  <main>
    <PageHeader title="Compétences" intro="Ce que je sais faire, et ce que j'ai construit." />
    <SkillsSection groups={skillGroups} />
    <section class="projects" aria-labelledby="projects-title">
      <h2 id="projects-title" class="projects__title">Projets</h2>
      <div class="projects__grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
