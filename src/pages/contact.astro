---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import SiteHeader from '../components/layout/site-header.astro';
import PageHeader from '../components/layout/page-header.astro';
import ContactForm from '../components/forms/contact-form.astro';
import SiteFooter from '../components/layout/site-footer.astro';
import Icon from '../components/ui/icon.astro';

const profile = await getEntry('site', 'profile');
const page = await getEntry('site', 'contact');
if (!profile || profile.data.kind !== 'profile') throw new Error('Missing or invalid src/content/site/profile.md');
if (!page || page.data.kind !== 'contact') throw new Error('Missing or invalid src/content/site/contact.md');

// Success flag set by the form service redirect (/contact?sent=1). The site is
// fully static, so the query string is read client-side (see the inline script
// below), not at build time.

// No email anywhere: contact goes through the form, then the socials and the CV PDF
const links = [
  ...profile.data.socials,
  { href: profile.data.cv.href, label: profile.data.cv.label, icon: 'download' as const },
];
---

<BaseLayout
  title={`${page.data.title} · ${profile.data.name}`}
  description={`${page.data.title} : contacter ${profile.data.name}, ${profile.data.headline.toLowerCase()}, via le formulaire, les réseaux ou le CV.`}
>
  <SiteHeader brand={profile.data.brand} nav={profile.data.nav} />
  <main>
    <PageHeader icon={page.data.icon} title={page.data.title} intro={page.data.intro} />
    <div class="contact">
      <p class="contact__success" role="status" hidden>
        <Icon name="check-circle" />
        {page.data.successMessage}
      </p>
      {page.data.linksTitle && <h2 class="contact__links-title">{page.data.linksTitle}</h2>}
      <ul class="contact__links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="btn btn--ghost contact__link"
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener me' : undefined}
              >
                <Icon name={link.icon} />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ContactForm form={page.data.form} />
    </div>
  </main>
  <SiteFooter name={profile.data.name} credit={profile.data.credit} socials={profile.data.socials} />
  <script is:inline>
    // Reveal the success message when the form service redirected back with ?sent=1
    if (new URLSearchParams(location.search).get('sent') === '1') {
      document.querySelector('.contact__success')?.removeAttribute('hidden');
    }
  </script>
</BaseLayout>
