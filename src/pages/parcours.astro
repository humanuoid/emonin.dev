---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import SiteHeader from '../components/layout/site-header.astro';
import PageHeader from '../components/layout/page-header.astro';
import SkillsSection from '../components/sections/skills-section.astro';
import ExperienceSection from '../components/sections/experience-section.astro';
import ProjectsSection from '../components/sections/projects-section.astro';
import ValuesSection from '../components/sections/values-section.astro';
import SiteFooter from '../components/layout/site-footer.astro';

const profile = await getEntry('site', 'profile');
const page = await getEntry('site', 'parcours');
if (!profile || profile.data.kind !== 'profile') throw new Error('Missing or invalid src/content/site/profile.md');
if (!page || page.data.kind !== 'parcours') throw new Error('Missing or invalid src/content/site/parcours.md');

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`${page.data.title} · ${profile.data.name}`}
  description={`${page.data.title} d'${profile.data.name}, ${profile.data.headline.toLowerCase()} : compétences, expériences et projets.`}
>
  <SiteHeader brand={profile.data.brand} nav={profile.data.nav} />
  <main>
    <PageHeader icon={page.data.icon} title={page.data.title} intro={page.data.intro} />
    <div class="band">
      <SkillsSection icon={page.data.sectionIcons.skills} title={page.data.titles.skills} groups={skills.map((s) => s.data)} />
    </div>
    <ExperienceSection
      icon={page.data.sectionIcons.experience}
      title={page.data.titles.experience}
      educationTitle={page.data.titles.education}
      entries={experience.map((e) => e.data)}
    />
    <div class="band">
      <ProjectsSection
        icon={page.data.sectionIcons.projects}
        title={page.data.titles.projects}
        linkLabels={page.data.projectLinkLabels}
        projects={projects.map((p) => p.data)}
      />
    </div>
    <ValuesSection
      icon={page.data.sectionIcons.values}
      title={page.data.titles.values}
      values={page.data.values}
      hobbies={page.data.hobbies}
    />
  </main>
  <SiteFooter name={profile.data.name} credit={profile.data.credit} socials={profile.data.socials} />
</BaseLayout>
