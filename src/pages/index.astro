---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/base-layout.astro';
import SiteHeader from '../components/layout/site-header.astro';
import HeroSection from '../components/sections/hero-section.astro';
import PreviewSection from '../components/sections/preview-section.astro';
import Callout from '../components/sections/callout.astro';
import SiteFooter from '../components/layout/site-footer.astro';

const profile = await getEntry('site', 'profile');
const home = await getEntry('site', 'home');
if (!profile || profile.data.kind !== 'profile') throw new Error('Missing or invalid src/content/site/profile.md');
if (!home || home.data.kind !== 'home') throw new Error('Missing or invalid src/content/site/home.md');
---

<BaseLayout
  title={`${profile.data.name} · ${profile.data.headline}`}
  description={profile.data.baseline}
>
  <SiteHeader brand={profile.data.brand} nav={profile.data.nav} />
  <main>
    <HeroSection hero={home.data.hero} availability={profile.data.availability} />
    <PreviewSection preview={home.data.preview} />
    {
      home.data.callout && (
        <Callout
          title={home.data.callout.title}
          text={home.data.callout.text}
          variant={home.data.callout.variant ?? 'accent'}
          sourcesLabel={home.data.callout.sourcesLabel}
          sources={home.data.callout.sources}
        />
      )
    }
  </main>
  <SiteFooter name={profile.data.name} credit={profile.data.credit} socials={profile.data.socials} />
</BaseLayout>
