---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import AvailabilityBadge from '../components/ui/availability-badge.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const profile = await getEntry('site', 'profile');

// The floating availability badge shows on inner pages only — the home page
// carries it inline in the hero instead
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showFloatingBadge = pathname !== '/';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme before first paint (no flash). With nothing saved,
      // the CSS media query keeps the site on the system preference.
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch (e) {}
    </script>
  </head>
  <body class={showFloatingBadge ? 'has-floating-badge' : undefined}>
    <slot />
    {
      profile && profile.data.kind === 'profile' && showFloatingBadge && (
        <AvailabilityBadge availability={profile.data.availability} variant="floating" />
      )
    }
    <script is:inline>
      // Theme switch: flips the effective theme, persists the explicit choice, keeps aria-checked in sync.
      function effectiveTheme() {
        var root = document.documentElement;
        return (
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        );
      }
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.setAttribute('aria-checked', effectiveTheme() === 'dark' ? 'true' : 'false');
        btn.addEventListener('click', function () {
          var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          btn.setAttribute('aria-checked', next === 'dark' ? 'true' : 'false');
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      });

      // Mobile nav: the hamburger toggles the dropdown panel (aria-expanded kept
      // in sync). It closes on link click, Escape, or when resizing to desktop.
      var nav = document.querySelector('.header__nav');
      var navToggle = document.querySelector('[data-nav-toggle]');
      if (nav && navToggle) {
        var closeNav = function () {
          nav.classList.remove('header__nav--open');
          navToggle.setAttribute('aria-expanded', 'false');
          navToggle.setAttribute('aria-label', 'Ouvrir le menu');
        };
        navToggle.addEventListener('click', function () {
          var open = nav.classList.toggle('header__nav--open');
          navToggle.setAttribute('aria-expanded', String(open));
          navToggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
        });
        nav.querySelectorAll('.header__link').forEach(function (link) {
          link.addEventListener('click', closeNav);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeNav();
        });
        window.addEventListener('resize', function () {
          if (window.innerWidth >= 640) closeNav();
        });
      }

      // Header nav: the shared underline sits ON the header's bottom border and
      // slides to the hovered/focused link, resting on the active one. Positions
      // are computed against the header box (the indicator is a header child).
      // Without JS the per-link :hover underline remains.
      var header = document.querySelector('.header');
      var navList = document.querySelector('.header__links');
      if (header && navList) {
        var indicator = header.querySelector('.header__indicator');
        var navLinks = Array.prototype.slice.call(navList.querySelectorAll('.header__link'));
        var activeLink = navList.querySelector('.header__link--active') || navLinks[0];
        function moveIndicator(link, isHover) {
          var headerRect = header.getBoundingClientRect();
          var linkRect = link.getBoundingClientRect();
          indicator.style.left = linkRect.left - headerRect.left + 'px';
          indicator.style.width = linkRect.width + 'px';
          indicator.classList.toggle('header__indicator--hover', !!isHover);
        }
        function snapIndicator() {
          indicator.style.transition = 'none';
          moveIndicator(activeLink, false);
          requestAnimationFrame(function () {
            indicator.style.transition = '';
          });
        }
        header.classList.add('header--animated');
        navLinks.forEach(function (link) {
          link.addEventListener('mouseenter', function () {
            moveIndicator(link, link !== activeLink);
          });
          link.addEventListener('focus', function () {
            moveIndicator(link, link !== activeLink);
          });
        });
        navList.addEventListener('mouseleave', function () {
          moveIndicator(activeLink, false);
        });
        navList.addEventListener('focusout', function () {
          moveIndicator(activeLink, false);
        });
        window.addEventListener('resize', snapIndicator);
        window.addEventListener('load', snapIndicator); // re-measure once fonts land
        snapIndicator();
      }
    </script>
  </body>
</html>
