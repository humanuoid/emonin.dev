---
import Icon from './icon.astro';
---

<!-- Light/dark switch. With no click, the site follows the system preference;
     the first click stores an explicit choice (see the inline script in base-layout). -->
<button
  type="button"
  class="theme-toggle icon-button"
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Basculer entre le thème clair et le thème sombre"
  title="Changer de thème"
>
  <span class="theme-toggle__knob">
    <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size={11} /></span>
    <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size={11} /></span>
  </span>
</button>
