---
interface SkillGroup {
  title: string;
  items: string[];
}

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<section class="skills" aria-labelledby="skills-title">
  <h2 id="skills-title" class="skills__title">Compétences</h2>
  <div class="skills__groups">
    {
      groups.map((group) => (
        <div class="skills__group">
          <h3 class="skills__group-title">{group.title}</h3>
          <ul class="skills__tags">
            {group.items.map((item) => (
              <li class="skills__tag">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
