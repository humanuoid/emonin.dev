---
import Icon from './icon.astro';

const year = new Date().getFullYear();

const socials = [
  { href: 'https://github.com/humanuoid', label: 'GitHub', icon: 'github' as const },
  { href: 'https://www.linkedin.com/in/emmanuel-dev-lyon/', label: 'LinkedIn', icon: 'linkedin' as const },
];
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__copyright">
      © {year} Emmanuel Monin · Site conçu avec l'aide de
      <a href="https://mistral.ai" rel="noopener" class="footer__credit">
        <Icon name="mistral" size={14} />
        Mistral AI
      </a>
    </p>
    <ul class="footer__socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} rel="me" aria-label={s.label} title={s.label} class="footer__social-link icon-button">
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
