---
// Home page teaser: three key skills and a call to action to /competences
const skills = [
  'Développement web full-stack',
  'Data & intelligence artificielle',
  'Conception produit',
];
---

<section class="preview" aria-labelledby="preview-title">
  <h2 id="preview-title" class="preview__title">Ce que je fais</h2>
  <ul class="preview__list">
    {skills.map((skill) => <li class="preview__item">{skill}</li>)}
  </ul>
  <a href="/competences" class="btn btn--ghost preview__cta">Voir mes compétences</a>
</section>
