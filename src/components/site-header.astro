---
import ThemeToggle from './theme-toggle.astro';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/competences', label: 'Compétences' },
  { href: '/contact', label: 'Contact' },
];

// Strip trailing slashes so /competences/ still marks the link as current
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="header">
  <nav class="header__nav" aria-label="Navigation principale">
    <a href="/" class="header__brand">emonin<span class="header__brand-dot">.</span>dev</a>
    <div class="header__right">
      <ul class="header__links">
        <li class="header__pill-li" aria-hidden="true"><span class="header__pill"></span></li>
        {
          links.map((link) => {
            const active = pathname === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['header__link', { 'header__link--active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
