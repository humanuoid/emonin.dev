---
import Icon from './icon.astro';
---

<!-- Light/dark switch. Both icons are always visible; the accent knob slides over
     the ACTIVE theme's icon (sun = light active, moon = dark active). With no click,
     the site follows the system preference; the first click stores an explicit
     choice (see the inline script in base-layout). -->
<button
  type="button"
  class="theme-toggle icon-button"
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Basculer entre le thème clair et le thème sombre"
  title="Changer de thème"
>
  <span class="theme-toggle__knob" aria-hidden="true"></span>
  <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size={0.85} stroke={2.5} /></span>
  <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size={0.85} stroke={2.5} /></span>
</button>
