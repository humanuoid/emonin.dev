---
import ThemeToggle from '../ui/theme-toggle.astro';

interface Props {
  brand: { name: string; domain: string };
  nav: Array<{ href: string; label: string }>;
}

const { brand, nav } = Astro.props;

// Strip trailing slashes so /parcours/ still marks the link as current
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="header">
  <nav class="header__nav" aria-label="Navigation principale">
    <a href="/" class="header__brand">{brand.name}<span class="header__brand-dot">.</span>{brand.domain}</a>
    <div class="header__right">
      <ul class="header__links">
        <li class="header__pill-li" aria-hidden="true"><span class="header__pill"></span></li>
        {
          nav.map((link) => {
            const active = pathname === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['header__link', { 'header__link--active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
