---
import ThemeToggle from '../ui/theme-toggle.astro';
import Icon from '../ui/icon.astro';

interface Props {
  brand: { name: string; role: string };
  nav: Array<{ href: string; label: string }>;
}

const { brand, nav } = Astro.props;

// Strip trailing slashes so /parcours/ still marks the link as current
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="header">
  <span class="header__loader" aria-hidden="true"></span>
  <span class="header__indicator" aria-hidden="true"></span>
  <nav class="header__nav" aria-label="Navigation principale">
    <a href="/" class="header__brand">
      <span class="header__brand-text">
        <span class="header__brand-name">{brand.name}</span>
        <span class="header__brand-role">{brand.role}</span>
      </span>
    </a>
    <div class="header__right">
      <ul class="header__links" id="header-nav">
        {
          nav.map((link) => {
            const active = pathname === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  class:list={['header__link', { 'header__link--active': active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
        <!-- On mobile the theme switch lives inside the burger menu; on desktop
             the same <li> renders inline at the end of the header row -->
        <li class="header__theme-item"><ThemeToggle /></li>
      </ul>
      <button
        type="button"
        class="header__menu-button icon-button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="header-nav"
        aria-label="Ouvrir le menu"
      >
        <span class="header__menu-icon header__menu-icon--close"><Icon name="menu" /></span>
        <span class="header__menu-icon header__menu-icon--open"><Icon name="x" /></span>
      </button>
    </div>
  </nav>
</header>
